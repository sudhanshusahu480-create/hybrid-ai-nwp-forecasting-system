# SIH26081 Environment Variables

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/weather_blender

# Redis
REDIS_URL=redis://localhost:6379/0

# Alerting
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_FROM_NUMBER=+1234567890
ALERT_EMAIL_FROM=alerts@weatherblender.in

# Data Sources
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
ECMWF_OPEN_DATA_URL=https://data.ecmwf.int/forecasts
